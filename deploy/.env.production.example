# Copia in deploy/.env.production (non va mai su git) e personalizza.
DJANGO_SECRET_KEY=genera-una-chiave-lunga-e-casuale
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=promipay.example.com
CSRF_TRUSTED_ORIGINS=https://promipay.example.com
FRONTEND_URL=https://promipay.example.com
# Attivali quando il sito e servito solo in HTTPS (dietro un proxy che termina TLS):
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

POSTGRES_DB=promipay
POSTGRES_USER=promipay
POSTGRES_PASSWORD=cambia-questa-password
DATABASE_URL=postgres://promipay:cambia-questa-password@db:5432/promipay

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=PromiPay <noreply@promipay.example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
